# ── Application ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" for any — dev only)
CORS_ORIGINS=*
# Expose Swagger UI at /docs (disable in production if you prefer)
SWAGGER_ENABLED=true

# ── Database ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=hesab
DB_PASSWORD=change-me-strong-password
DB_NAME=hesab_kitab
# Set to true to require TLS to the database (managed Postgres providers)
DB_SSL=false
# Run pending migrations automatically at application start
DB_MIGRATIONS_RUN=true

# ── Auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-64-hex-chars
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days of non-use (sliding window)
REFRESH_TOKEN_TTL_DAYS=30

# ── Encryption ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting sensitive columns (contact phone numbers).
# MUST be exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
# Losing this key makes encrypted data unrecoverable — back it up.
ENCRYPTION_KEY=replace-with-64-hex-chars

# ── Rate limiting ──────────────────────────────────────────────
# General API limit: requests per minute per IP
THROTTLE_LIMIT=120
# Stricter limit for auth endpoints (login/signup/refresh) per minute per IP
THROTTLE_AUTH_LIMIT=10
